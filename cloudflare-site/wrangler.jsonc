{
  "$schema": "../cloudflare-horoscopo/node_modules/wrangler/config-schema.json",
  "name": "popzun",
  "main": "src/index.js",
  "compatibility_date": "2026-08-04",
  "workers_dev": true,
  "services": [
    {
      "binding": "HOROSCOPO",
      "service": "popzun-horoscopo"
    }
  ],
  "assets": {
    "directory": "../.popzun-public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}

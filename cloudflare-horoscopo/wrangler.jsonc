{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "popzun-horoscopo",
  "main": "src/index.js",
  "compatibility_date": "2026-08-03",
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    {
      "binding": "HOROSCOPO_DB",
      "id": "587e94f552114ba298cba84149fd0e0d"
    }
  ],
  "triggers": {
    "crons": ["5 6 * * *"]
  }
}
